# Copy to aws/spot.env (git-ignored) and fill in. Nothing here is secret; credentials stay in your AWS CLI profile.
AWS_PROFILE=""                 # REQUIRED, no default on purpose: the profile for the account that should pay for this
EXPECTED_ACCOUNT_ID=""         # REQUIRED: the 12-digit account id of that profile; every script refuses to run on any other account
AWS_REGION="us-east-1"
VPC_ID=""                      # REQUIRED: VPC to launch in
SUBNET_IDS=""                  # REQUIRED: space-separated PUBLIC subnets (route to an internet gateway); tried in order on capacity errors         # the Vesuvius Challenge open-data bucket is in us-east-1 (in-region S3 reads are fast and free)
INSTANCE_TYPE="g4dn.2xlarge"   # T4 16 GB, 8 vCPU, x86. Alternatives: g5.2xlarge (A10G 24 GB), g6.2xlarge (L4 24 GB)
INSTANCE_TYPES="g4dn.2xlarge g5.xlarge g4dn.xlarge"   # tried in order (x subnets) when spot capacity is short; all must fit under MAX_PRICE
RETRY_MINUTES="20"             # keep retrying the whole list this long before giving up
MARKET="spot"                  # spot (default) or ondemand; ondemand ignores MAX_PRICE (g4dn.2xlarge on-demand ~$0.75/h)
MAX_PRICE="0.45"               # spot bid ceiling in $/h (g4dn.2xlarge spot was ~$0.31 on 2026-10-09)
VOLUME_GB="150"                # root gp3 volume, deleted on termination
MAX_HOURS="3"                  # HARD LIMIT: the instance powers itself off (and is terminated) after this many hours
KEY_NAME="scroll-prize-spot"   # EC2 key pair created on first use; private key kept in aws/state/ (git-ignored)
SG_NAME="scroll-prize-spot-ssh" # security group allowing SSH only from this Mac's current public IP
PROJECT_TAG="scroll-prize"     # every resource is tagged Project=<this>; teardown only touches tagged resources
VILLA_COMMIT="12f21236a"       # villa commit to install (same as the GPU box on 2026-10-09)
AMI_SSM="/aws/service/deeplearning/ami/x86_64/base-oss-nvidia-driver-gpu-ubuntu-24.04/latest/ami-id"  # Ubuntu 24.04 (the VC3D AppImage needs glibc >= 2.39)
VC3D_RELEASE="latest"          # villa GitHub release tag that carries the Linux VC3D AppImage

# GPU box (ssh target) used by stage_segments.sh, fleet_score.sh, fleet_3model.sh
BOX="user@your-gpu-box"
